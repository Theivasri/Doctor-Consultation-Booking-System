@model DCBS.ViewModel.AppointmentOverviewViewModel

<h2>🗂️ Appointment Overview</h2>

<h4 class="text-primary mt-4">Upcoming Appointments</h4>
@if (!Model.Upcoming.Any())
{
    <p>No upcoming appointments.</p>
}
else
{
    <table class="table table-bordered">
        <thead><tr><th>Date</th><th>Department</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Upcoming)
        {
            <tr><td>@a.Date.ToShortDateString()</td><td>@a.Department</td></tr>
        }
        </tbody>
    </table>
}

<h4 class="text-success mt-4">Completed Appointments</h4>
@if (!Model.Completed.Any())
{
    <p>No completed appointments.</p>
}
else
{
    <table class="table table-bordered">
        <thead><tr><th>Date</th><th>Department</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Completed)
        {
            <tr><td>@a.Date.ToShortDateString()</td><td>@a.Department</td></tr>
        }
        </tbody>
    </table>
}

<h4 class="text-danger mt-4">Cancelled Appointments</h4>
@if (!Model.Cancelled.Any())
{
    <p>No cancelled appointments.</p>
}
else
{
    <table class="table table-bordered">
        <thead><tr><th>Date</th><th>Department</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Cancelled)
        {
            <tr><td>@a.Date.ToShortDateString()</td><td>@a.Department</td></tr>
        }
        </tbody>
    </table>
}
